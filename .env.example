# ====================================================================
# JobHuntAI India - Environment Configuration
# ====================================================================

# 1. Google Gemini AI (Required for resume parsing & match scoring)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Cloudflare D1 Serverless Database (Recommended for 24/7 Mobile & Laptop Access)
# Free forever edge SQLite database: https://dash.cloudflare.com
# Find Account ID: Cloudflare Dashboard -> Right Sidebar
# Find Database ID: Cloudflare Dashboard -> Workers & Pages -> D1 -> jobhuntai-db
# Create API Token: https://dash.cloudflare.com/profile/api-tokens (Create Token -> "Edit Cloudflare Workers" or custom D1 Edit template)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# 3. Supabase Cloud Database (Alternative free option)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. Optional Web Scrapers
# Firecrawl: https://firecrawl.dev
FIRECRAWL_API_KEY=
# Apify: https://apify.com
APIFY_API_TOKEN=
